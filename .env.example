APP_ENV=
DATABASE_SYNC_URL=
DATABASE_ASYNC_URL=
DATABASE_PGQ_URL=
AMQP_DSN=

# issuer url -> scope prefixes the issuer may assert (JSON)
JWT_ISSUERS=
# JWT_AUDIENCE=

# local-only dev keypair: mint tokens with `uv run python -m statement.infra.local_auth`
# (PEM on one line, newlines escaped as \n). Do NOT reuse outside local.
JWT_LOCAL_PRIVATE_KEY=

# HMAC key for optimistic-lock version tokens. Rotating it invalidates every
# token clients are holding: their next update gets a 409 until they re-read
VERSION_TOKEN_SECRET=

LOG_LEVEL=

# for pgqueuer
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=