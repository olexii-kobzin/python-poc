APP_ENV=test
DATABASE_SYNC_URL=postgresql+psycopg://db_user:db_password@localhost:5432/test_db
DATABASE_ASYNC_URL=postgresql+asyncpg://db_user:db_password@localhost:5432/test_db
DATABASE_PGQ_URL=postgresql://db_user:db_password@localhost:5432/test_db
AMQP_DSN=
# issuer url -> scope prefixes the issuer may assert (JSON)
JWT_ISSUERS='{"https://issuer.test":["statement."]}'
VERSION_TOKEN_SECRET=test-only-version-token-secret
LOG_LEVEL=WARNING
# for pgqueuer
PGHOST=localhost
PGPORT=5432
PGUSER=db_user
PGPASSWORD=db_password
PGDATABASE=test_db