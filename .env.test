APP_ENV=test
DATABASE_SYNC_URL=postgresql+psycopg://study:study@postgresql:5432/statement_test
DATABASE_ASYNC_URL=postgresql+asyncpg://study:study@postgresql:5432/statement_test
DATABASE_PGQ_URL=postgresql://study:study@postgresql:5432/statement_test
AMQP_DSN=amqp://study:study@rabbitmq:5672/

# issuer url -> scope prefixes the issuer may assert (JSON)
JWT_ISSUERS='{"https://issuer.test": ["statement."]}'

LOG_LEVEL=WARNING

# for pgqueuer
PGHOST=postgresql
PGPORT=5432
PGUSER=study
PGPASSWORD=study
PGDATABASE=statement_test